# Copy to .env. Set an absolute private storage directory.
NUXT_DATABASE_URL=postgresql://museflow:museflow_local@127.0.0.1:5432/museflow
NUXT_STORAGE_ROOT=
NUXT_PUBLIC_APP_NAME=MuseFlow
# Production: node --env-file=.env .output/server/index.mjs

# Only used by pnpm test:db. Explicitly target a disposable test database.
TEST_DATABASE_URL=postgresql://museflow:museflow_local@127.0.0.1:5432/museflow_test
