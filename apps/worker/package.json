    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": { "@museflow/database": "workspace:*", "zod": "4.6.5" },
  "devDependencies": { "tsx": "4.23.15", "typescript": "5.9.3" }
